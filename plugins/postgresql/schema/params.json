{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostgreSQL HA & PITR Configuration",
  "type": "object",
  "required": ["syncProfile", "port"],
  "properties": {
    "syncProfile": {
      "type": "string",
      "enum": ["async", "sync", "sync-strict"],
      "default": "sync",
      "x-kinstall-ui": { "group": "basic", "order": 1, "label": "同步复制与 RPO 档位" }
    },
    "port": {
      "type": "integer",
      "default": 5432,
      "x-kinstall-ui": { "group": "network", "order": 10, "label": "PostgreSQL 端口" }
    },
    "pgbouncerPort": {
      "type": "integer",
      "default": 6432,
      "x-kinstall-ui": { "group": "network", "order": 11, "label": "PgBouncer 连接池端口" }
    },
    "haproxyWritePort": {
      "type": "integer",
      "default": 5000,
      "x-kinstall-ui": { "group": "network", "order": 12, "label": "HAProxy 写入口端口" }
    },
    "haproxyReadPort": {
      "type": "integer",
      "default": 5001,
      "x-kinstall-ui": { "group": "network", "order": 13, "label": "HAProxy 读入口端口" }
    },
    "pgBackRestVersion": {
      "type": "string",
      "default": "2.60.0",
      "x-kinstall-ui": { "group": "backup", "order": 20, "label": "pgBackRest 版本 (>= 2.60.0 强制要求)" }
    },
    "backupS3Bucket": {
      "type": "string",
      "default": "kinstall-pg-backups",
      "x-kinstall-ui": { "group": "backup", "order": 21, "label": "S3 / 华为云 OBS 备份桶" }
    },
    "backupCredRef": {
      "type": "string",
      "x-kinstall-ui": { "group": "backup", "order": 22, "widget": "credential-select", "label": "备份对象存储凭据" }
    }
  }
}
