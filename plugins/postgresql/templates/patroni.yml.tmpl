scope: {{ .ClusterName }}
name: {{ .NodeName }}

restapi:
  listen: 0.0.0.0:8008
  connect_address: {{ .HostIP }}:8008

etcd3:
  hosts:
{{ range .EtcdHosts }}    - {{ . }}:2379
{{ end }}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: {{ .SyncMode }}
    synchronous_mode_strict: {{ .SyncStrict }}
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        wal_log_hints: "on"
        shared_buffers: "{{ .SharedBuffersMB }}MB"
        effective_cache_size: "{{ .EffectiveCacheMB }}MB"
        maintenance_work_mem: "{{ .MaintenanceWorkMB }}MB"
        huge_pages: try
        archive_mode: "on"
        archive_command: "pgbackrest --stanza={{ .ClusterName }} archive-push %p"
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:{{ .Port }}
  connect_address: {{ .HostIP }}:{{ .Port }}
  data_dir: /data/postgresql/{{ .ClusterName }}/data
