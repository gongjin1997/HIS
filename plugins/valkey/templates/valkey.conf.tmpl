# Managed by kinstall (Valkey {{ .Version }})
bind {{ .BindIP }} 127.0.0.1
protected-mode yes
{{ if .TLSEnabled -}}
port 0
tls-port {{ .Port }}
tls-cert-file /etc/kinstall/valkey/{{ .InstanceName }}/tls.crt
tls-key-file /etc/kinstall/valkey/{{ .InstanceName }}/tls.key
tls-ca-cert-file /etc/kinstall/valkey/{{ .InstanceName }}/ca.crt
tls-protocols "TLSv1.2 TLSv1.3"
tls-replication yes
tls-cluster yes
{{ else -}}
port {{ .Port }}
{{ end -}}
dir /data/valkey/{{ .InstanceName }}
aclfile /etc/kinstall/valkey/{{ .InstanceName }}/users.acl
maxmemory {{ .MaxMemoryMB }}mb
maxmemory-policy allkeys-lru
{{ if eq .PersistenceMode "none" -}}
save ""
appendonly no
{{ else -}}
save 900 1 300 10 60 10000
appendonly yes
appendfsync everysec
{{ end -}}
{{ if eq .Topology "cluster" -}}
cluster-enabled yes
cluster-config-file nodes.conf
cluster-node-timeout 5000
cluster-announce-ip {{ .BindIP }}
cluster-announce-port {{ .Port }}
cluster-announce-bus-port {{ .BusPort }}
{{ end -}}
