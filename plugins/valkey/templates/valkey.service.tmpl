[Unit]
Description=kinstall Valkey ({{ .InstanceName }})
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=valkey
Group=valkey
ExecStart=/opt/kinstall/bin/valkey/{{ .Version }}/valkey-server /etc/kinstall/valkey/{{ .InstanceName }}/valkey.conf --supervised systemd
Restart=always
RestartSec=3
LimitNOFILE=65535
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
