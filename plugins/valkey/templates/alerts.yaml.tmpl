groups:
  - name: kinstall-valkey-alerts
    rules:
      - alert: ValkeyRejectedConnections
        expr: increase(redis_rejected_connections_total[5m]) > 0
        for: 1m
        labels: { severity: critical, product: valkey }
        annotations: { summary: "Valkey rejecting client connections (maxclients reached)" }
      - alert: ValkeyHighMemoryFragmentation
        expr: redis_mem_fragmentation_ratio > 1.5
        for: 10m
        labels: { severity: warning, product: valkey }
        annotations: { summary: "Valkey memory fragmentation ratio above 1.5" }
      - alert: ValkeyRDBSaveFailed
        expr: redis_rdb_last_bgsave_status != 1
        for: 1m
        labels: { severity: critical, product: valkey }
        annotations: { summary: "Valkey last RDB BGSAVE failed (check vm.overcommit_memory / disk)" }
      - alert: ValkeyClusterStateDown
        expr: redis_cluster_state != 1
        for: 1m
        labels: { severity: critical, product: valkey }
        annotations: { summary: "Valkey Cluster state is not OK" }
