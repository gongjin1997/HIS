{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valkey / Redis Configuration",
  "type": "object",
  "required": ["topology", "port"],
  "properties": {
    "topology": {
      "type": "string",
      "enum": ["standalone", "replication-sentinel", "cluster"],
      "default": "replication-sentinel",
      "x-kinstall-ui": { "group": "basic", "order": 1, "label": "集群拓扑形态" }
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 55535,
      "default": 6379,
      "x-kinstall-ui": { "group": "network", "order": 10, "label": "服务监听端口" }
    },
    "sentinelPort": {
      "type": "integer",
      "default": 26379,
      "x-kinstall-ui": { "group": "network", "order": 11, "label": "哨兵端口", "visibleWhen": "topology == 'replication-sentinel'" }
    },
    "persistenceMode": {
      "type": "string",
      "enum": ["aof-rdb", "rdb", "none"],
      "default": "aof-rdb",
      "x-kinstall-ui": { "group": "storage", "order": 20, "label": "持久化模式 (影响 COW 内存上限 0.65 / 0.80)" }
    },
    "maxMemoryMB": {
      "type": "integer",
      "minimum": 128,
      "default": 0,
      "x-kinstall-ui": { "group": "resources", "order": 30, "label": "最大内存 MB (0 = 自动按 COW 安全公式计算)" }
    },
    "tlsEnabled": {
      "type": "boolean",
      "default": true,
      "x-kinstall-ui": { "group": "security", "order": 40, "label": "启用全链路 TLS 1.2/1.3" }
    },
    "adminCredentialRef": {
      "type": "string",
      "x-kinstall-ui": { "group": "security", "order": 41, "widget": "credential-select", "label": "管理员 ACL 凭据" }
    },
    "enableExporter": {
      "type": "boolean",
      "default": true,
      "x-kinstall-ui": { "group": "observability", "order": 50, "label": "部署 redis_exporter (:9121)" }
    }
  }
}
